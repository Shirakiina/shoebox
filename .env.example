# ---------- 访问密码 ----------
# 单用户，只有一个密码。留空 = 不设防（任何人都能访问）。
# 改密码会让所有已登录的设备立即失效。
APP_PASSWORD=

# ---------- 存储 ----------
# local = 存本机磁盘（默认，适合调试）
# r2    = 存 Cloudflare R2
STORAGE_DRIVER=local

# local 驱动的落盘目录
STORAGE_DIR=./storage

# SQLite 元数据库位置
DB_PATH=./data/shoebox.db

# ---------- Cloudflare R2 ----------
# 只有 STORAGE_DRIVER=r2 或运行 npm run sync:r2 时才需要
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=shoebox

# 可选：R2 的公开访问域名（自定义域或 pub-xxx.r2.dev）
# 留空则回落到签名 URL（1 小时有效），功能一样，只是每次要签一下
R2_PUBLIC_BASE=
